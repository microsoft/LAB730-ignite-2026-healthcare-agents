{
  "servers": {
    "medimageinsight": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${workspaceFolder}/mcp/medimageinsight-server",
        "mcp",
        "run",
        "server.py"
      ],
      "env": {
        "MI2_ENV_FILE": "${workspaceFolder}/mcp/medimageinsight-server/.env"
      }
    }
  }
}
